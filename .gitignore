# ============================================================
# VRChat Bio Watcher (VRCBW)
# ★ 最重要的一条：凭据和本地数据绝对不能进 git
# ============================================================

# --- 凭据 / 会话 cookie（一旦提交，等于把账号送人）---
.probe-cookies.json
.probe-cookies.json.*
.probe-credentials.json
*.cookies.json
.env
.env.*
credentials.json
!credentials.example.json

# --- 本地数据（bio 快照属于隐私数据，同理不进仓库）---
data/
scripts/_probe-out/

# --- 依赖与构建产物 ---
node_modules/
out/
dist/
dist-electron/
release/
*.tsbuildinfo

# --- 缓存（放在项目内，原因见 .npmrc 与 scripts/install-deps.ps1）---
.npm-cache/
.electron-cache/
.electron-builder-cache/

# --- 开发期临时产物 ---
_dev/
dev-log.txt

# --- 日志与临时文件 ---
*.log
npm-debug.log*
.tmp/

# --- 编辑器与系统 ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
